{
  "name": "goankipathsala-backend",
  "version": "0.1.0",
  "description": "Multi-Tenant School Management & EdTech SaaS Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed:regression": "tsx src/scripts/seed-regression-data.ts",
    "key:generate": "tsx src/scripts/manage-platform-key.ts --generate",
    "key:check": "tsx src/scripts/manage-platform-key.ts --test"
  },
  "keywords": [
    "school-management",
    "edtech",
    "multi-tenant",
    "lms",
    "saas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15"
  }
}
