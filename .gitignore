# ==============================================================================
# Goan Ki Pathshala (गाँव की पाठशाला) - Monorepo Git Ignore
# Covers: Monorepo Root, Frontend (Next.js), and Backend (Node.js/Express/Prisma)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 2. Node & Package Managers (Root, Frontend, Backend)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Environment & Secrets (Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# Allow example / template environment files
!.env.example
!*.env.example
!*.env.sample
!*.env.template

# Certificates and keys
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 4. Backend (Node.js / Express / TypeScript / Prisma)
# ------------------------------------------------------------------------------
backend/dist/
dist/
build/
backend/build/

# Prisma SQLite / local databases (if used)
*.db
*.db-journal
*.sqlite
*.sqlite3

# TypeScript build info
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. Frontend (Next.js / React / Tailwind)
# ------------------------------------------------------------------------------
frontend/.next/
.next/
frontend/out/
out/
.turbo/
frontend/.turbo/

# Vercel deployment artifacts
.vercel/
frontend/.vercel/

# Next.js TypeScript declarations (auto-generated)
next-env.d.ts

# ------------------------------------------------------------------------------
# 6. Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
*/coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 7. Temporary & Scratch Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
scratch/
tmp/
